{
  "name": "@relayrtc/react",
  "version": "0.1.0",
  "description": "React providers and hooks for RelayRTC rooms, media, messages and connection quality.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
