    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/relayrtc/react-sdk.git"
  },
  "homepage": "https://github.com/relayrtc/react-sdk#readme",
  "bugs": "https://github.com/relayrtc/react-sdk/issues",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": { "access": "public" },
  "peerDependencies": {
    "@relayrtc/client": "^0.0.0",
    "react": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@relayrtc/client": "link:../relaykit/packages/client",
    "@types/react": "^18.3.1",
    "react": "^18.3.1",
    "typescript": "^5.7.3"
  }
}
